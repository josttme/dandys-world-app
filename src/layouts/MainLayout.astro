---
// src/layouts/MainLayout.astro
import { ClientRouter } from "astro:transitions";
const { title } = Astro.props;
import "@styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    class="m-0 overflow-hidden bg-[#202020] bg-[repeating-linear-gradient(-70deg,rgba(0,0,0,0.1)_0px,rgba(0,0,0,0.1)_50px,transparent_50px,transparent_100px)] p-0 font-sans text-white selection:bg-yellow-400 selection:text-black"
  >
    <slot />
  </body>
</html>

