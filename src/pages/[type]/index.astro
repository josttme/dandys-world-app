---
// src/pages/[type]/index.astro
import MainLayout from "@/layouts/MainLayout.astro";
import CharacterList from "@/components/character-list/CharacterList";
import { getToons } from "@/services/toonService";

export async function getStaticPaths() {
  const allToons = getToons({});
  // Set para obtener tipos únicos ('toon', 'twisted')
  const types = [...new Set(allToons.map((t) => t.type))];

  return types.map((type) => ({
    params: { type },
  }));
}

const { type } = Astro.params;

// Validamos que 'type' sea un string válido, si no typescript se queja
const filterType = typeof type === "string" ? type : "toon";

// Opcional: Seleccionamos el primero de este tipo por si queremos pre-selección
const toonsOfType = getToons({ categories: [], searchTerm: "" }).filter(
  (t) => t.type === filterType
);
const firstToonId = toonsOfType[0]?.id;
---

<MainLayout title={`Personajes tipo: ${filterType}`}>
  <main
    class="h-[calc(100vh-(--spacing(16)))] w-full overflow-hidden bg-slate-950"
  >
    {
      /* REUTILIZACIÓN TOTAL:
      Usamos el mismo componente que en la Home, pero le pasamos
      el filtro 'filterByType' fijo desde la URL.
    */
    }
    <CharacterList
      client:load
      filterByType={filterType}
      initialId={firstToonId}
    />
  </main>
</MainLayout>
