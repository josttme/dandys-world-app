---
// src/pages/[type]/[category]/[id].astro
import MainLayout from "@/layouts/MainLayout.astro";
import CharacterList from "@/components/character-list/CharacterList";
import CharacterDetail from "@/components/character-detail/CharacterDetail";
import { getToons } from "@/services/toonService";
import type { Toon } from "@/types";
import { ArrowLeft } from "lucide-react"; // Asumiendo que tienes lucide instalado

export async function getStaticPaths() {
  const allToons = getToons({});
  return allToons.map((toon) => ({
    params: {
      type: toon.type,
      category: toon.category || "normal", // Fallback por seguridad
      id: toon.id,
    },
    props: { toon },
  }));
}

interface Props {
  toon: Toon;
}

const { type } = Astro.params;
const { toon } = Astro.props;
---

<MainLayout
  title={`${toon.name} | Dandy's Wiki`}
  description={toon.description}
  image={toon.images.full}
>
  {/* LAYOUT CONTENEDOR: H-SCREEN para app feeling */}
  <div class="flex h-screen w-full overflow-hidden bg-slate-950">
    {
      /* =========================================================
        ZONA 1: SIDEBAR (LISTA)
        - Hidden en Mobile (porque estamos viendo el detalle)
        - Flex en Desktop
        - transition:persist es VITAL: Mantiene el scroll y filtros
          al navegar entre personajes.
       ========================================================= */
    }
    <aside
      class="hidden w-full flex-col border-r border-slate-800 bg-slate-900/50 md:flex lg:w-200"
      transition:persist="sidebar-list"
    >
      <div class="flex-1 overflow-hidden">
        <CharacterList client:load initialId={toon.id} filterByType={type} />
      </div>
    </aside>

    {
      /* =========================================================
        ZONA 2: MAIN CONTENT (DETALLE)
        - Ocupa todo en Mobile.
        - Flex-1 en Desktop.
        - transition:animate="fade" para suavizar el cambio de datos.
       ========================================================= */
    }
    <main
      class="relative flex-1 overflow-x-hidden overflow-y-auto scroll-smooth bg-slate-950"
      transition:animate="fade"
    >
      {
        /* BOTÓN VOLVER (SOLO MÓVIL) 
          Flotante, estilo "glassmorphism".
          Lleva a la lista filtrada por el tipo actual.
      */
      }
      <a
        href={`/${type}`}
        class="fixed top-4 left-4 z-50 flex items-center justify-center rounded-full border border-white/10 bg-black/40 p-3 text-white backdrop-blur-md transition-all hover:bg-black/60 active:scale-95 md:hidden"
        aria-label="Volver a la lista"
      >
        <ArrowLeft size={20} />
      </a>

      {/* Renderizamos el detalle del personaje */}
      <div class="min-h-full">
        {/* Aquí pasamos el objeto toon completo al componente de detalle */}
        <CharacterDetail char={toon} client:visible />
      </div>
    </main>
  </div>
</MainLayout>
