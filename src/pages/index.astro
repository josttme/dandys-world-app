---
import MainLayout from "@/layouts/MainLayout.astro";
import CharacterList from "@/components/character-list/CharacterList";
// Ya no necesitamos importar getToons aquí para pasarlo como prop
// import { getToons } from "@/services/toonService";

const title = "Dandy's World Wiki | Database";
const description =
  "Base de datos completa de Toons y Twisted de Dandy's World.";

// Definimos quién es el destacado por defecto (opcional)
const DEFAULT_ID = "astro";
---

<MainLayout title={title} description={description}>
  <main
    class="h-[calc(100vh-(--spacing(16)))] w-full overflow-hidden bg-slate-950"
  >
    {
      /* CORRECCIÓN: Eliminamos 'initialData'. 
      El componente CharacterList es autónomo y autosuficiente.
    */
    }
    <CharacterList client:load initialId={DEFAULT_ID} filterByType="toon" />
  </main>
</MainLayout>
