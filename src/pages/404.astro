---
// src/pages/404.astro
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="404 - Página no encontrada">
  <div
    class="flex h-screen flex-col items-center justify-center bg-slate-950 p-4 text-center"
  >
    <h1 class="font-display text-9xl font-bold text-slate-800 select-none">
      404
    </h1>

    <div class="absolute flex flex-col items-center gap-4">
      <div class="h-24 w-24 animate-bounce text-6xl">👻</div>
      <h2 class="text-2xl font-bold text-white">
        ¡Ups! Te has perdido en el ascensor.
      </h2>
      <p class="max-w-md text-slate-400">
        El personaje o la página que buscas no existe o ha sido eliminado por un
        Twisted.
      </p>

      <a
        href="/"
        class="mt-4 rounded-xl bg-yellow-500 px-6 py-3 font-bold text-black transition-transform hover:scale-105 hover:bg-yellow-400"
      >
        Volver al Lobby
      </a>
    </div>
  </div>
</MainLayout>
