---
// src/pages/[characterId].astro
import { getToons } from "@/services/toonService";
import type { Toon } from "@/types";

export async function getStaticPaths() {
  const allToons = getToons({});

  return allToons.map((toon) => ({
    params: { characterId: toon.id },
    props: { toon },
  }));
}

interface Props {
  toon: Toon;
}

const { toon } = Astro.props;

// Redirección permanente (301) es mejor para SEO que 302
return Astro.redirect(`/${toon.type}/${toon.category}/${toon.id}`, 301);
---
