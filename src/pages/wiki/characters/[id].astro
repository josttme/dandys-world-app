---
import Layout from "@layouts/Layout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const characters = await getCollection("characters");
  return characters.map((entry) => ({
    params: { id: entry.id },
    props: { character: entry },
  }));
}

interface Props {
  character: CollectionEntry<"characters">;
}
const { character } = Astro.props;
const { data } = character;

// Buscar Twisted (Relación)
let twistedData = null;
if (data.relatedTwisted) {
  const allChars = await getCollection("characters");
  // @ts-ignore (A veces TS se queja si el ID no es string exacto, esto lo silencia seguro)
  twistedData = allChars.find((c) => c.id === data.relatedTwisted.id);
}
---

<Layout title={`${data.name} | Dandy's World Wiki`}>
  {/* CONTENEDOR PRINCIPAL: Altura mínima de pantalla completa, fondo oscuro */}
  <main
    class="relative min-h-screen overflow-x-hidden bg-[#050505] text-white selection:bg-yellow-500/30"
  >
    {/* --- CAPA 1: FONDO AMBIENTAL (Blurry Background) --- */}
    <div class="pointer-events-none fixed inset-0 z-0">
      {
        /* Usamos la imagen del personaje super ampliada y borrosa para dar color ambiental */
      }
      <Image
        src={data.assets.fullBody}
        alt=""
        class="absolute inset-0 h-full w-full scale-150 object-cover opacity-20 mix-blend-screen blur-[100px]"
      />
      {/* Viñeta oscura para centrar la atención */}
      <div
        class="bg-radial-gradient absolute inset-0 from-transparent via-[#050505]/80 to-[#050505]"
      >
      </div>
      <div
        class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay"
      >
      </div>
    </div>

    {/* --- CAPA 2: NAVEGACIÓN SUPERIOR (Breadcrumbs + ID) --- */}
    <div
      class="relative z-40 mx-auto flex w-full max-w-[1600px] items-start justify-between px-8 py-6"
    >
      <Breadcrumbs
        items={[
          { label: "Database", href: "/characters" },
          {
            label: data.category,
            href: `/characters?filter=${data.category.toLowerCase()}`,
          },
          { label: data.name },
        ]}
      />
      {/* REGISTRY ID STAMP */}
      <div class="flex flex-col items-end opacity-60">
        <span
          class="font-mono text-[10px] tracking-[0.3em] text-yellow-500/80 uppercase"
          >Subject ID</span
        >
        <span
          class="border-r-4 border-yellow-500 pr-3 font-mono text-3xl font-bold text-white"
        >
          {data.code}
        </span>
      </div>
    </div>

    {/* --- CAPA 3: EL ESCENARIO CENTRAL (Grid de 3 Columnas) --- */}
    {
      /* En móvil es columna única, en Desktop es Left(25%) - Center(50%) - Right(25%) */
    }
    <div
      class="relative z-10 mx-auto grid min-h-[80vh] max-w-[1600px] grid-cols-1 items-center gap-8 px-6 lg:grid-cols-12 lg:gap-0 lg:px-12"
    >
      {/* COLUMNA IZQUIERDA: Stats & Datos Técnicos (HUD) */}
      <div class="order-2 space-y-12 lg:order-1 lg:col-span-3">
        {/* Header del Personaje (Solo visible aquí en Móvil/Tablet) */}
        <div class="mb-8 text-center lg:hidden">
          <h1
            class="bg-gradient-to-b from-white to-gray-500 bg-clip-text text-6xl font-black tracking-tighter text-transparent uppercase italic"
          >
            {data.name}
          </h1>
        </div>

        {/* Panel de Estadísticas Estilo RPG */}
        <div class="space-y-6">
          <h3
            class="border-b border-gray-800 pb-2 text-sm font-bold tracking-widest text-gray-500 uppercase"
          >
            Performance Stats
          </h3>

          {/* Generamos las barras de stats */}
          {
            [
              {
                label: "Health",
                val: data.stats.ratings.health,
                max: 5,
                color: "bg-red-500",
              },
              {
                label: "Stamina",
                val: data.stats.ratings.stamina,
                max: 5,
                color: "bg-yellow-400",
              },
              {
                label: "Speed",
                val: data.stats.ratings.movementSpeed,
                max: 5,
                color: "bg-blue-400",
              },
              {
                label: "Stealth",
                val: data.stats.ratings.stealth,
                max: 5,
                color: "bg-purple-500",
              },
            ].map((stat) => (
              <div>
                <div class="mb-1 flex justify-between font-mono text-xs">
                  <span class="text-gray-300">{stat.label}</span>
                  <span class="text-white">{stat.val}/5</span>
                </div>
                <div class="h-2 w-full overflow-hidden rounded-full border border-white/5 bg-gray-800/50 backdrop-blur-sm">
                  <div
                    class={`h-full ${stat.color} shadow-[0_0_10px_currentColor] transition-all duration-1000 ease-out`}
                    style={`width: ${(stat.val / stat.max) * 100}%`}
                  />
                </div>
              </div>
            ))
          }

          {/* Datos RAW (Velocidad exacta) */}
          <div class="grid grid-cols-2 gap-4 pt-4">
            <div
              class="rounded border border-white/10 bg-white/5 p-3 text-center"
            >
              <div class="text-[10px] text-gray-400 uppercase">Walk Speed</div>
              <div class="font-mono text-xl font-bold text-blue-300">
                {data.stats.raw?.walkSpeed}
              </div>
            </div>
            <div
              class="rounded border border-white/10 bg-white/5 p-3 text-center"
            >
              <div class="text-[10px] text-gray-400 uppercase">
                Sprint Speed
              </div>
              <div class="font-mono text-xl font-bold text-yellow-300">
                {data.stats.raw?.sprintSpeed}
              </div>
            </div>
          </div>
        </div>

        {/* Requisitos de Desbloqueo (Mini Card) */}
        <div
          class="rounded-xl border border-gray-800 bg-gradient-to-br from-gray-900 to-black p-5"
        >
          <div class="mb-2 text-xs tracking-widest text-gray-500 uppercase">
            Acquisition Cost
          </div>
          <div class="mb-4 flex items-center gap-3">
            <span class="text-3xl font-bold text-white">{data.unlock.cost}</span
            >
            <span
              class="rounded border border-purple-500/30 bg-purple-900/30 px-2 py-1 text-sm font-bold text-purple-400"
            >
              {data.unlock.currency}
            </span>
          </div>
          <ul class="space-y-2">
            {
              data.unlock.requirements?.map((req) => (
                <li class="flex items-start gap-2 text-xs text-gray-400">
                  <span class="mt-0.5 text-green-500">✔</span>
                  {req.description}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {/* COLUMNA CENTRAL: EL HÉROE (Imagen Gigante) */}
      <div
        class="relative order-1 flex h-[60vh] items-center justify-center lg:order-2 lg:col-span-6 lg:h-[85vh]"
      >
        {/* Efecto de "Suelo" o Pedestal */}
        <div
          class="absolute bottom-10 h-20 w-[80%] rounded-[100%] bg-black/50 blur-3xl"
        >
        </div>

        {/* Título GIGANTE detrás del personaje (Efecto WoW Moderno) */}
        <h1
          class="pointer-events-none absolute top-1/2 left-1/2 z-0 -translate-x-1/2 -translate-y-1/2 text-[12vw] font-black tracking-tighter whitespace-nowrap text-white/5 uppercase italic select-none lg:text-[10rem]"
        >
          {data.name}
        </h1>

        {/* IMAGEN PRINCIPAL */}
        {
          /* Usamos drop-shadow en lugar de box-shadow para que la sombra siga el contorno del dibujo */
        }
        <Image
          src={data.assets.fullBody}
          alt={data.name}
          width={1000}
          quality={100}
          class="animate-float-slow relative z-10 h-full w-auto object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
          style="mask-image: linear-gradient(to bottom, black 90%, transparent 100%);"
        />
        {/* (El mask-image suaviza los pies con el suelo) */}
      </div>

      {/* COLUMNA DERECHA: Lore & Habilidades */}
      <div
        class="order-3 flex flex-col justify-center space-y-10 lg:col-span-3"
      >
        {/* Título (Visible solo en Desktop para no duplicar) */}
        <div class="hidden lg:block">
          <div class="mb-2 flex items-center gap-3">
            <span
              class="rounded-sm bg-yellow-500 px-2 py-0.5 text-xs font-bold text-black uppercase"
            >
              {data.category}
            </span>
            <span class="font-mono text-xs text-gray-500"
              >Released: {
                data.releaseDate.toLocaleDateString("es-ES", {
                  timeZone: "UTC",
                })
              }</span
            >
          </div>
          <h1
            class="mb-6 bg-gradient-to-b from-white to-gray-400 bg-clip-text text-7xl leading-[0.8] font-black tracking-tighter text-transparent uppercase italic"
          >
            {data.name}
          </h1>
          <p
            class="border-l-2 border-yellow-500/50 pl-4 text-sm leading-relaxed text-gray-300 lg:text-base"
          >
            {data.description}
          </p>
        </div>

        {/* Habilidades (Cards Compactas) */}
        <div>
          <h3
            class="mb-4 border-b border-gray-800 pb-4 text-sm font-bold tracking-widest text-gray-500 uppercase"
          >
            Active & Passive Abilities
          </h3>

          <div class="space-y-4">
            {
              data.abilities.map((ability) => (
                <div class="group relative rounded-lg border border-white/5 bg-gray-900/60 p-4 transition-all duration-300 hover:border-yellow-500/50">
                  <div class="flex items-start gap-4">
                    {/* Icono */}
                    <div class="relative flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded border border-gray-700 bg-black">
                      {ability.icon ? (
                        <Image
                          src={ability.icon}
                          alt={ability.name}
                          class="h-full w-full object-cover"
                        />
                      ) : (
                        <span class="text-xl font-bold text-gray-600">
                          {ability.name[0]}
                        </span>
                      )}
                      {/* Cooldown Overlay */}
                      {ability.cooldown && (
                        <div class="absolute inset-0 flex items-center justify-center bg-black/60 font-mono text-[10px] text-white opacity-0 transition-opacity group-hover:opacity-100">
                          {ability.cooldown}s
                        </div>
                      )}
                    </div>

                    <div>
                      <div class="mb-1 flex items-center justify-between">
                        <h4 class="font-bold text-white transition-colors group-hover:text-yellow-400">
                          {ability.name}
                        </h4>
                        <span
                          class={`rounded px-1.5 py-0.5 text-[10px] font-bold uppercase ${ability.type === "Active" ? "bg-blue-900/50 text-blue-300" : "bg-green-900/50 text-green-300"}`}
                        >
                          {ability.type}
                        </span>
                      </div>
                      <p class="line-clamp-2 text-xs leading-relaxed text-gray-400 transition-all group-hover:line-clamp-none">
                        {ability.description}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    {/* --- SECCIÓN INFERIOR: DETALLES EXTRA & TWISTED --- */}
    <div
      class="relative z-10 mt-[-5vh] border-t border-white/10 bg-black/80 backdrop-blur-xl"
    >
      <div
        class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-6 py-16 md:grid-cols-2"
      >
        {/* Columna Izquierda: Maestría (Si existe) */}
        <div>
          {
            data.mastery && (
              <>
                <h3 class="mb-6 flex items-center gap-2 text-2xl font-bold text-white">
                  <span class="text-yellow-500">★</span> Mastery Progression
                </h3>
                <div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6">
                  <div class="mb-6 flex items-center gap-4">
                    <div class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-yellow-400 bg-gradient-to-br from-yellow-600 to-yellow-800 shadow-[0_0_15px_rgba(234,179,8,0.3)]">
                      <span class="text-2xl">👑</span>
                    </div>
                    <div>
                      <div class="text-xs font-bold text-yellow-500 uppercase">
                        Reward
                      </div>
                      <div class="text-xl font-bold text-white">
                        {data.mastery.reward.skinName}
                      </div>
                    </div>
                  </div>

                  <div class="space-y-3">
                    {data.mastery.tasks.map((task) => (
                      <div class="flex items-center justify-between border-b border-gray-800 pb-2 text-sm last:border-0">
                        <span class="text-gray-300">{task.description}</span>
                        <span class="font-mono text-gray-500">
                          0/{task.count}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            )
          }
        </div>

        {/* Columna Derecha: TWISTED VERSION (La tarjeta roja) */}
        <div>
          {
            twistedData ? (
              <div class="group relative cursor-pointer overflow-hidden rounded-xl border border-red-900/30 bg-gradient-to-br from-red-950/20 to-black p-8 transition-colors hover:border-red-500/50">
                <div class="absolute top-0 right-0 p-4 opacity-20 transition-opacity group-hover:opacity-100">
                  <span class="animate-pulse font-mono text-xs tracking-widest text-red-500 uppercase">
                    Threat Detected
                  </span>
                </div>

                <div class="relative z-10 flex items-center gap-6">
                  <Image
                    src={twistedData.data.assets.avatar}
                    alt={twistedData.data.name}
                    width={120}
                    height={120}
                    class="rounded-lg border-2 border-red-900/50 shadow-lg grayscale transition-all duration-500 group-hover:grayscale-0"
                  />
                  <div>
                    <h3 class="mb-2 text-3xl font-black text-red-500 uppercase italic">
                      {twistedData.data.name}
                    </h3>
                    <p class="mb-4 line-clamp-2 max-w-md text-sm text-red-200/60">
                      {twistedData.data.description}
                    </p>
                    <a
                      href={`/wiki/characters/${twistedData.id}`}
                      class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-red-400 uppercase transition-colors hover:text-white"
                    >
                      Access File <span class="text-lg">→</span>
                    </a>
                  </div>
                </div>

                {/* Ruido de fondo rojo */}
                <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay" />
              </div>
            ) : (
              <div class="flex h-full items-center justify-center rounded-xl border border-dashed border-gray-800 p-8 opacity-50">
                <span class="font-mono text-xs text-gray-500">
                  NO KNOWN TWISTED VARIANT RECORDED
                </span>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </main>
</Layout>

{/* ESTILOS GLOBALES PARA ANIMACIONES */}
<style>
  /* Animación suave de flotación para el personaje principal */
  @keyframes float-slow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }
  .animate-float-slow {
    animation: float-slow 6s ease-in-out infinite;
  }
</style>
